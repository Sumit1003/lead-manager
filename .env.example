# Copy this file to .env and adjust. Never commit a real .env with secrets.
# Server port (backend API). Default: 5000.
PORT=5000
# Path to the SQLite database file. Default: server/leads.db
# DB_PATH=./leads.db
# Frontend API base URL (only needed if the frontend is hosted separately).
# Leave empty to use the same origin / Vite dev proxy.
# VITE_API_URL=http://localhost:5000
